{
  "name": "videodubber-desktop",
  "version": "0.9.0",
  "description": "VideoDubber desktop UI (Angular 22 standalone) running inside a Tauri 2 shell.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ng serve --port 1420",
    "start": "ng serve --port 1420",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node ../../scripts/check-i18n.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@tauri-apps/api": "2.11.1",
    "@videodubber/shared": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@tauri-apps/cli": "2.11.4",
    "typescript": "6.0.3"
  }
}
