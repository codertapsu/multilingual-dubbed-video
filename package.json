{
  "name": "videodubber",
  "version": "0.9.0",
  "private": true,
  "description": "VideoDubber \u2014 a local/offline-first desktop app that dubs videos into another language.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "node scripts/run.mjs bootstrap",
    "doctor": "tsx scripts/verify-environment.ts",
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "stop": "node scripts/run.mjs stop",
    "services": "node scripts/run.mjs start-services",
    "app": "pnpm --filter videodubber-desktop tauri dev",
    "app:build": "pnpm --filter videodubber-desktop tauri build",
    "dev:desktop": "pnpm --filter videodubber-desktop dev",
    "dev:orchestrator": "pnpm --filter @videodubber/node-orchestrator dev",
    "dev:workers": "node scripts/run.mjs dev-workers",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./workers/media-worker\" build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:workers": "node scripts/run.mjs test-workers",
    "test:all": "pnpm test && pnpm test:workers",
    "check": "pnpm lint && pnpm typecheck && pnpm test:all && node scripts/check-versions.mjs && node scripts/check-tasks.mjs",
    "package:sidecars": "node scripts/run.mjs package/build-sidecars",
    "dmg:instructions": "node scripts/run.mjs package/dmg-add-instructions",
    "release": "node scripts/run.mjs release",
    "release:check": "node scripts/run.mjs release --check",
    "release:status": "node scripts/release-status.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:version": "node scripts/release-version.mjs",
    "desktop:rebuild": "node scripts/clean-build.mjs",
    "verify": "tsx scripts/verify-environment.ts",
    "eval:translation": "tsx scripts/eval-translation.ts",
    "diagnose:llama": "node scripts/run.mjs diagnose-llama-engine"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
