# scripts/apple-credentials.env.example
#
# Copy to `scripts/apple-credentials.env` and fill in. That filename is
# git-ignored (repo-root .gitignore); THIS example is committed, and must never
# contain a real value.
#
#   cp scripts/apple-credentials.env.example scripts/apple-credentials.env
#   chmod 600 scripts/apple-credentials.env
#   # fill it in, then before a macOS release:
#   set -a && . ./scripts/apple-credentials.env && set +a
#   pnpm release --upload
#
# `pnpm release --check` reports all four as MISSING until they are exported —
# it reads the environment, not this file, so sourcing is not optional.
#
# Verify the values WITHOUT paying for a 20-minute build first:
#   security find-identity -v -p codesigning | grep "$APPLE_SIGNING_IDENTITY"
#   xcrun notarytool history --apple-id "$APPLE_ID" \
#         --password "$APPLE_PASSWORD" --team-id "$APPLE_TEAM_ID"
# The second one authenticates against Apple and fails fast on a bad password.

# The keychain identity used to deep-sign the bundle. Must match, exactly, a line
# from `security find-identity -v -p codesigning`, trailing "(TEAMID)" included.
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# The Apple ID the Developer Program membership belongs to.
export APPLE_ID="you@example.com"

# An APP-SPECIFIC password from appleid.apple.com -> Sign-In and Security.
# NOT your Apple ID password, and a real secret: anyone holding it can notarize
# as you. Revoke it from that page if it ever leaves this machine.
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your 10-character Team ID. It is the value in parentheses above.
export APPLE_TEAM_ID="TEAMID"
